{
    "openapi": "3.1.0", 
    "info": {
        "title": "MTA Service API", 
        "description": "Makes requests to MTA API and saves into a database", 
        "version": "1.0.0"
    }, 
    "servers": [
        {"url": " http://3.84.62.68:5001/", "description": "server on AWS EC2"}
    ], 
    "paths": {
        "/equipments/{station}": {
            "get": {
                "summary": "Get equipments info for the station from MTA API", 
                "description": "Returns a list of equipments info for the station", 
                "responses": {
                    "200": {
                        "description": "A JSON array of equipments info", 
                        "content": {
                            "application/json": {
                                "schema": {"type": "array", "items": "equipment info"}
                            }
                        }
                    }
                }
            }
        }, 
        "/outages/{station}": {
            "get": {
                "summary": "Get outages info for the station from MTA", 
                "description": "returns all outages (escalators and/or elevators) associated with the station",
                "responses": {
                    "200": {
                        "description": "A JSON array of outages info", 
                        "content": {
                            "application/json": {
                                "schema": {"type": "array", "items": "outages info"}
                            }
                        }
                    }
                }
            }
        }
    }
}